{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Database Manager",
  "version": "0.0.10",
  "identifier": "com.gtrave.database-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Database Manager",
        "width": 620,
        "height": 520,
        "minWidth": 480,
        "minHeight": 360,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dbm-server"
    ],
    "resources": ["../plugins/**/*"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["database-manager"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Tutitoos/database-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBQzc5RUQxRjIzOEMwOTkKUldTWndEankwWjdIYWxTVDYxamMreUZBS1NPRTRyYWhHbkJwY2FseUI1WW9wSGdRVENBOSs3QjAK"
    }
  }
}
