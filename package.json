{
  "name": "database-manager",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "plugins:build": "sh scripts/build-plugins.sh",
    "server:build:sidecar": "sh scripts/build-server.sh",
    "tauri": "tauri",
    "tauri:dev": "pnpm plugins:build && pnpm server:build:sidecar && tauri dev",
    "tauri:build": "pnpm plugins:build && pnpm server:build:sidecar && tauri build",
    "server": "sh server/run.sh release",
    "server:debug": "sh server/run.sh debug",
    "server:watch": "sh server/run.sh watch",
    "server:build": "cargo build --release -p dbm-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@tanstack/react-pacer": "^0.13.0",
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/react-store": "^0.7.0",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.13.0",
    "@tanstack/store": "^0.7.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-codemirror": "^4.23.7",
    "clsx": "^2.1.1",
    "i18next": "^26.2.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.8",
    "recharts": "^3.8.1",
    "simple-icons": "^16.20.0",
    "sql-formatter": "^15.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.5.2",
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^2.1.8"
