# Bind
PORT=8787
BIND_ADDR=0.0.0.0

# SQLite path (mount as a volume in Docker)
DATABASE_URL=./data/server.db

# Public URL that OAuth providers will redirect to.
# Required behind reverse proxies. Example: https://sync.example.com
PUBLIC_BASE_URL=

# Deep link the server redirects back to after OAuth completes.
# Desktop app handles this scheme. Don't change unless you re-brand.
DEEP_LINK_REDIRECT=database-manager://auth/callback

# OAuth credentials (register apps at each provider's developer console)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Logging
RUST_LOG=info,tower_http=info
